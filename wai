#!/usr/bin/env bash
# wai -- WPA2 Handshake Capture CLI.
# Usage: sudo wai <cap|scan|mon|deth|opt|scope|run> [flags]
# AUTHORIZED NETWORKS ONLY -- educational / lab use.
#
# RESPONSABILIDAD UNICA: dispatch de subcomandos. Cada cmd_<sub>
# valida argumentos, corre preflight e invoca la funcion del modulo
# correspondiente. La logica de negocio vive en lib/*.sh.

if [ -z "$BASH_VERSION" ]; then
    exec bash "$0" "$@"
fi

set -Eeuo pipefail

WAI_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LIB_DIR="${WAI_DIR}/lib"

source "${LIB_DIR}/constants.sh"
source "${LIB_DIR}/logging.sh"
source "${LIB_DIR}/help.sh"
source "${LIB_DIR}/state.sh"
source "${LIB_DIR}/cleanup.sh"
source "${LIB_DIR}/args.sh"
source "${LIB_DIR}/meta.sh"
source "${LIB_DIR}/preflight.sh"
source "${LIB_DIR}/monitor.sh"
source "${LIB_DIR}/scan.sh"
source "${LIB_DIR}/clients.sh"
source "${LIB_DIR}/deauth.sh"
source "${LIB_DIR}/capture.sh"
source "${LIB_DIR}/output.sh"
source "${LIB_DIR}/scope.sh"

main() {
    local sub="${1:-}"
    local arg2="${2:-}"

    # Per-subcommand help: intercept BEFORE preflight / install_trap, so
    # `wai <sub> -h` works without root and without cleanup noise.
    case "${arg2}" in
    -h | --help)
        case "${sub}" in
        cap)   help_cap;   exit 0 ;;
        scan)  help_scan;  exit 0 ;;
        mon)   help_mon;   exit 0 ;;
        deth)  help_deth;  exit 0 ;;
        opt)   help_opt;   exit 0 ;;
        scope) help_scope; exit 0 ;;
        run)   help_run;   exit 0 ;;
        esac
        ;;
    esac

    shift || true

    case "$sub" in
    cap)   cmd_cap   "$@" ;;
    scan)  cmd_scan  "$@" ;;
    mon)   cmd_mon   "$@" ;;
    deth)  cmd_deth  "$@" ;;
    opt)   cmd_opt   "$@" ;;
    scope) cmd_scope "$@" ;;
    run)   cmd_run   "$@" ;;
    -V | --version | version) version ;;
    -h | --help | help | "") usage ;;
    *) die "Unknown subcommand: '${sub}'  (use -h for help)" ;;
    esac
}

cmd_cap() {
    parse_cap_args "$@"
    banner "cap"
    preflight cap
    install_trap
    monitor_up
    run_targets
}

cmd_scan() {
    parse_scan_args "$@"
    banner "scan"
    preflight scan
    install_trap
    monitor_up
    run_scan "$SCAN_SEC"
    ok "Scan finished. CSV at ${TMP}/scan-01.csv"
    # No explicit cleanup: the EXIT trap runs exactly once.
}

cmd_mon() {
    parse_mon_args "$@"
    banner "mon"
    case "$MON_ACTION" in
    on)
        preflight mon
        install_trap
        monitor_up
        ok "Monitor mode active: ${MON}"
        info "Run 'wai mon off' or Ctrl+C to restore the system."
        info "Exiting without disabling - the interface stays in monitor mode."
        trap - EXIT INT TERM
        ;;
    off)
        preflight mon
        install_trap
        monitor_down
        ;;
    esac
}

cmd_deth() {
    parse_deth_args "$@"
    banner "deth"
    preflight deth
    install_trap
    monitor_up
    deth_run
}

cmd_opt() {
    parse_opt_args "$@"
    banner "opt"
    preflight opt
    install_trap
    opt_run
}

cmd_scope() {
    local sub="${1:-show}"
    case "$sub" in
    show | "")   scope_show ;;
    edit)        scope_edit ;;
    add)         shift; scope_add "${1:-}" ;;
    rm)          shift; scope_rm  "${1:-}" ;;
    clear)       scope_clear ;;
    -h | --help) help_scope ;;
    *) die "scope: subcomando desconocido '${sub}'  (show|edit|add|rm|clear)" ;;
    esac
}

cmd_run() {
    parse_run_args "$@"
    banner "run"
    preflight run
    install_trap
    scope_init
    local entries
    entries="$(scope_read)"
    if [[ -z "$entries" ]]; then
        warn "scope vacio: ${SCOPE_FILE}"
        warn "agrega entradas con: wai scope add <SSID|BSSID>"
        return 0
    fi
    TARGETS_RAW=()
    local l
    while IFS= read -r l; do
        TARGETS_RAW+=("$l")
    done <<< "$entries"
    info "capturas -> ${OUTDIR}"
    monitor_up
    run_targets
}

main "$@"
